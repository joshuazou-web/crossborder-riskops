# CrossBorder RiskOps - configuration.
#
# Copy to `.env` only if you want to change something. Every value below has a
# working default, and the entire product - demo, dashboard, evaluation - runs
# with no API key at all.
#
# NEVER commit a real key. `.env` is gitignored; this file is not.

# --- synthetic data ---------------------------------------------------------
# The seed. Every number in the evaluation report is tied to it, so changing it
# changes the report and that is the intended way to test robustness.
RISKOPS_SEED=20260815
RISKOPS_N_TRANSACTIONS=6000
RISKOPS_N_MERCHANTS=120
RISKOPS_N_WALLETS=900
RISKOPS_HISTORY_DAYS=90
# Fixed reporting cut-off keeps every metric reproducible.
RISKOPS_AS_OF=2026-08-31

# --- risk policy thresholds --------------------------------------------------
# Below this combined score, and with nothing above low severity, the policy
# auto-releases without a human.
RISKOPS_AUTO_RELEASE_BELOW=0.25
# At or above this, the policy stops the payment. It still opens a case: the
# money is safe by default, the outcome is a person's to confirm.
RISKOPS_AUTO_HOLD_AT=0.92
# Settlement reconciliation tolerance, in basis points.
RISKOPS_FX_TOLERANCE_BPS=75
RISKOPS_DUPLICATE_WINDOW_SECONDS=900
RISKOPS_VELOCITY_WINDOW_MINUTES=10
RISKOPS_VELOCITY_THRESHOLD=6
RISKOPS_SLA_CRITICAL_HOURS=2
RISKOPS_SLA_HIGH_HOURS=8
RISKOPS_SLA_MEDIUM_HOURS=24
RISKOPS_SLA_LOW_HOURS=72

# --- AI copilot --------------------------------------------------------------
# `mock` is the default and needs no key. It is a deterministic stand-in, not a
# language model, and the evaluation report labels every figure with the
# provider that produced it.
RISKOPS_LLM_PROVIDER=mock
RISKOPS_LLM_MODEL=mock-deterministic-v1

# To use a real model instead, set the provider to `openai_compatible` and fill
# in the three lines below. Any OpenAI-shaped /chat/completions endpoint works.
# RISKOPS_LLM_PROVIDER=openai_compatible
# RISKOPS_LLM_BASE_URL=https://api.openai.com/v1
# RISKOPS_LLM_API_KEY=sk-your-key-here
# RISKOPS_LLM_MODEL=gpt-4o-mini

RISKOPS_LLM_TIMEOUT=30
RISKOPS_LLM_MAX_TOKENS=1200
RISKOPS_LLM_TEMPERATURE=0.0
# Below this confidence the copilot's recommendation is downgraded to `abstain`.
RISKOPS_AI_MIN_CONFIDENCE=0.55
RISKOPS_AI_REDACT_PII=true

# --- paths and logging --------------------------------------------------------
# RISKOPS_DATA_DIR=./data
# RISKOPS_REPORTS_DIR=./reports
RISKOPS_LOG_LEVEL=INFO

# --- provider comparison ------------------------------------------------------
# scripts/run_provider_comparison.py regenerates briefs for a fixed sample of
# cases once per model and writes reports/provider_comparison.{json,md}. It never
# touches the committed reports/evaluation.json.
# RISKOPS_COMPARE_MODELS=<model-id-a>,<model-id-b>
# RISKOPS_COMPARE_SAMPLE=40
